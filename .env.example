APP_NAME=Enterprise Business Management System
APP_VERSION=1.0.0
ENVIRONMENT=development

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=enterprise_business_management_system

REDIS_HOST=localhost
